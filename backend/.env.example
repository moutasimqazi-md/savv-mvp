APP_NAME="Savv MVP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# MariaDB 10.11.19 only. Do not point this at any other database engine.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=savv_mvp
DB_USERNAME=savv_moutasim
DB_PASSWORD=CHANGE_THIS_IN_LOCAL_ENV

# Redis is intentionally not used anywhere in Savv MVP.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Node.js Playwright runner (see /runner). Binds to 127.0.0.1 only - never
# exposed publicly. Generate a long random value, e.g.:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
RUNNER_BASE_URL=http://127.0.0.1:3010
RUNNER_SHARED_SECRET=CHANGE_THIS_LOCALLY
# false for Windows/local headed-Chromium development, true on the Ubuntu
# noVNC demonstration deployment.
RUNNER_STREAM_ENABLED=false
# A fresh Chromium install's first-ever launch can be slower than later
# ones (e.g. antivirus scanning the newly-extracted binary) - bump this if
# "Could not start the temporary browser" appears right after first setup.
RUNNER_REQUEST_TIMEOUT_SECONDS=30

# Rotate this if it is ever exposed. See docs/privacy-model.md for rotation guidance.
APP_FIELD_ENCRYPTION_KEY=

MAIL_MAILER=log
