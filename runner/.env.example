# Bind address for the internal API. Never change this to 0.0.0.0 - the
# runner must never be reachable from outside the local machine.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3010

# Must match backend/.env's RUNNER_SHARED_SECRET exactly.
RUNNER_SHARED_SECRET=CHANGE_THIS_LOCALLY

# false on Windows/local dev (headed Chromium opens on the developer's own
# screen). true on the Ubuntu demo deployment (Xvfb + x11vnc + noVNC).
RUNNER_HEADED=true

# Only used when RUNNER_HEADED=false, i.e. the Ubuntu Xvfb deployment.
# Each session gets its own display number allocated at runtime starting
# from this base (see src/display/displayAllocator.js).
RUNNER_DISPLAY_BASE=100

RUNNER_MAX_LIFETIME_MINUTES=15
RUNNER_MAX_TIMESTAMP_SKEW_SECONDS=300
RUNNER_MAX_PAGES_PER_SCAN=5
RUNNER_PAGE_NAVIGATION_DELAY_MS=1500

# Root directory for temporary per-session Chromium profiles. Each session
# gets a unique subdirectory that is deleted when the session ends.
RUNNER_PROFILE_ROOT=./tmp/profiles

# Only used when RUNNER_HEADED=false. Directory of small "token -> host:port"
# files read by the shared, long-lived websockify broker's TokenFile plugin
# (docs/samples/supervisor-savv-websockify.conf) - never a directory served
# directly by the web server.
RUNNER_VNC_TOKEN_DIR=./tmp/vnc-tokens
